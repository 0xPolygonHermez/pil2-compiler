airtemplate A (int N = 2**8) {
    col witness a,b;

    const expr x = a + 'b + 1;

    // a const expr is printed by name, with its row offset; the shifted expansion
    // is checked on the pilout by test/const_expr_row_offset.js
    assert_eq(string(x), "x");
    assert_eq(string(x'), "x'");
    assert_eq(string('x), "'x");
    assert_eq(string(x'2), "x'2");
    assert_eq(string(2'x), "2'x");

    expr y  = b + b'2;

    assert_eq(string(y), "b + b'2");
    assert_eq(string(y'), "b' + b'3");
    assert_eq(string('y),  "'b + b'");
    assert_eq(string(y'2 + y'2), "b'2 + b'4 + b'2 + b'4");
    assert_eq(string(2'y + 3'y), "2'b + b + 3'b + 'b");

    const expr z = a;

    assert_eq(string(z), "a");
    assert_eq(string(z'), "a'");
    assert_eq(string('z), "'a");
    assert_eq(string(z'2), "a'2");
    assert_eq(string(2'z), "2'a");

    const expr w = a';

    assert_eq(string(w), "a'");
    assert_eq(string(w'), "a'2");
    assert_eq(string('w), "a");
    assert_eq(string(w'2), "a'3");
    assert_eq(string(2'w), "'a");

    assert_eq(string(a), "a");
    assert_eq(string(a'), "a'");
    assert_eq(string('a), "'a");
    assert_eq(string(a'2), "a'2");
    assert_eq(string(2'a), "2'a");

    assert_eq(string(a+b'), "a + b'");
    assert_eq(string(a'+b), "a' + b");
    assert_eq(string(a+'b), "a + 'b");
    assert_eq(string('a+'b), "'a + 'b");
    assert_eq(string('a+b'), "'a + b'");

    assert_eq(string(a+b'3+2'b), "a + b'3 + 2'b");



    int i = 0;
    int j = 3;
    int j2 = -2;
    const expr k = (0)'a + b'(3)+b'(-2);
    k === 0;

    const expr k2 = (i)'a + b'(j)+b'(j2);
    k2 === 0;

    assert_eq(string(k), "k");
    assert_eq(string(k2), "k2");


    assert_eq(string((i)'a + b'(j)+b'(j2)), "a + b'3 + 2'b");

    x === 0;
    x' === 0;
    'x === 0;
    x'2 === 0;
    2'x === 0;

    y === 0;
    y' === 0;
    'y === 0;
    y'2 + y'2 === 0;
    2'y + 3'y === 0;

    z === 0;
    z' === 0;
    'z === 0;
    z'2 === 0;
    2'z === 0;

    w === 0;
    w' === 0;
    'w === 0;
    w'2 === 0;
    2'w === 0;

    a === 0;
    a' === 0;
    'a === 0;
    a'2 === 0;
    2'a === 0;
}

airgroup A1 {
    A();
}