proofval rom_root1;
public rom_root[4];
public rom2_root[4];
public usualops_root[4];
public usualops2_root[4];
public rom_b_root[4];
public rom2_b_root[4];

commit stage(18) public(usualops_root) usualops;
// ERROR, its publics are already used by usualops: commit stage(1) public(usualops_root) usualops3;
commit stage(9) public(usualops2_root) usualops2;

airtemplate CommitTest(int N = 2**13) {
    commit stage(1) public(rom_root) rom;
    commit stage(13) public(rom2_root) rom2;
    col rom stage(2) line;
    col rom stage(2) line2;
    col usualops values;
    col usualops2 values2;
    col rom2 instruction;
    col rom2 instruction2;

    instruction === instruction2 ;
    line + line2 + 10 === 0;
    values + 12 === 0;
    values2 + 10 === 0;
}


airtemplate CommitTest2(int N = 2**13) {
    // the publics of a commit can't be shared with another commit
    commit stage(1) public(rom_b_root) rom;
    commit stage(11) public(rom2_b_root) rom2;
    col rom stage(2) line;
    col rom2 instruction;
    // col usualops values;
    col usualops2 values2;

    instruction - 20 === 0;
    line + 10 === 0;
    values2 + 15 === 0;
}

airgroup Commit {
    CommitTest();
    CommitTest2();
}