airtemplate AirA(int N = 2**16) {
    col witness a,b,c,d;
    std_call_range_check();
}

airtemplate AirB(int N = 2**16) {
    col witness a,b;
    std_call_range_check();
}

function std_call_range_check() {
    on final airgroup range_check();
}

function range_check() {
    // runs on the final of each airgroup: prints 0 and then 1
    println("AIRGROUP_ID",AIRGROUP_ID);
    // adds an AirC instance to the airgroup being closed, the alias tells them apart
    AirC() alias `AirC_${AIRGROUP_ID}`;
}

airtemplate AirC(int N = 2**16) {
    col witness a,b;
}

airgroup AirA {
    AirA();
}
airgroup AirB {
    AirB();
}